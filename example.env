RUNNER_UID=1000
RUNNER_GID=1000
RUNNER_SOCKET_DIR=/run/hivemake-runner
RUNNER_BIND_IP=127.0.0.1
RUNNER_PORT=7183
RUNNER_IMAGE=hivemake-runner:local
# Publishing only: export RUNNER_IMAGE_REPOSITORY in your shell.
